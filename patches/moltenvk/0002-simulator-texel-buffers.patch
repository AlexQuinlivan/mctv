 #pragma mark Metal
 
+#if MVK_OS_SIMULATOR
+// MCTV: the tvOS simulator only makes linear textures on private buffers, so a
+// view of any other buffer reads a private copy, refreshed each time it is
+// bound, through a queue of its own (scripts/build-moltenvk.sh).
+id<MTLTexture> MVKBufferView::getMTLTextureFromCopy() {
+	lock_guard<mutex> lock(_lock);
+	id<MTLBuffer> src = _buffer->getMTLBuffer();
+	NSUInteger srcOffset = _buffer->getMTLBufferOffset() + _offset;
+	NSUInteger size = _mtlBytesPerRow;
+	if (srcOffset >= src.length) { return _mtlTexture; }
+	if (srcOffset + size > src.length) { size = src.length - srcOffset; }
+	@autoreleasepool {
+		if ( !_mtlTexture ) {
+			_mtlCopy = [getMTLDevice() newBufferWithLength: _mtlBytesPerRow options: MTLResourceStorageModePrivate];
+			MTLTextureDescriptor* mtlTexDesc = [MTLTextureDescriptor textureBufferDescriptorWithPixelFormat: _mtlPixelFormat
+			                                                                                      width: _textureSize.width
+			                                                                            resourceOptions: MTLResourceStorageModePrivate
+			                                                                                      usage: MTLTextureUsageShaderRead];
+			_mtlTexture = [_mtlCopy newTextureWithDescriptor: mtlTexDesc offset: 0 bytesPerRow: _mtlBytesPerRow];
+			_device->makeResident(_mtlCopy);
+			_device->makeResident(_mtlTexture);
+			_device->getLiveResources().add(_mtlTexture);
+			propagateDebugName();
+		}
+		static id<MTLCommandQueue> copyQueue = [getMTLDevice() newCommandQueue];
+		id<MTLCommandBuffer> cb = [copyQueue commandBuffer];
+		id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+		[blit copyFromBuffer: src sourceOffset: srcOffset toBuffer: _mtlCopy destinationOffset: 0 size: size];
+		[blit endEncoding];
+		[cb commit];
+		[cb waitUntilCompleted];
+	}
+	return _mtlTexture;
+}
+#endif
