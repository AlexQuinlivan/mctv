# Optional. Copy to config/server.env to set up a JIT server (server/README.md).

# SSH host of an always-on computer on the TV's network, Linux or macOS.
SERVER_HOST=
# Name or address the TV uses to reach it.
SERVER_NAME=
# The Apple TV's IP address. jitd answers nothing else. Comma separated for more.
TV_ADDRESSES=
# Optional. The address jitd listens on (all of the server's addresses by default).
SERVER_LISTEN=
# Optional, macOS. The LaunchDaemon's label, and extra PATH for it.
JITD_LABEL=local.mctv.jitd
SERVER_PATH=
# Optional. A command to run when the TV asks for JIT, and a token that lets
# another program on a JITD_HOOK_ALLOW address run it with POST /hook.
JITD_ON_JIT=
JITD_HOOK_TOKEN=
JITD_HOOK_ALLOW=
