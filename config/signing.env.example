# Copy to config/signing.env, or let scripts/setup.sh or scripts/set-team.sh write it.
# Needed only for the Apple TV, not the simulator.

# Your team ID (Xcode > Settings > Accounts).
DEVELOPMENT_TEAM=
# Bundle IDs become <prefix>.app26 and so on. Use a name of your own.
BUNDLE_PREFIX=com.example.mctv
# The Apple TV's CoreDevice identifier (xcrun devicectl list devices). Found by itself if empty.
DEVICE=
# Team IDs the scripts must never sign with. Optional.
REFUSE_TEAMS=""
