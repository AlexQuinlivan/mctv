# scripts/deploy-server.sh writes this file on the JIT server. It's here for running jitd by hand.
JITD_LISTEN=0.0.0.0:25566
JITD_ALLOW=192.0.2.20
JITD_TOKEN=
JITD_TV_PYTHON=/home/you/.local/share/mctv-jitd/venv/bin/python
JITD_TV_IDENTIFIER=
JITD_BUNDLE_ID=com.example.mctv.app26
JITD_DDI_DIR=/home/you/.local/share/mctv-jitd/ddi/tvOS_DDI/Restore
# macOS only, see scripts/deploy-server.sh
JITD_TV_SSH=
JITD_TV_SSH_KEY=
# Optional, see jitd.py
JITD_ON_JIT=
JITD_HOOK_TOKEN=
JITD_HOOK_ALLOW=
